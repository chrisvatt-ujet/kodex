#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: kodex <profile> [codex args...]
       kodex <profile> usage [--json]

Runs codex with CODEX_HOME set to a profile-specific directory.

Environment:
  KODEX_PROFILES_DIR  Profile root directory. Default: ~/.kodex/profiles
  KODEX_CODEX_BIN     Codex binary to run. Default: codex
  KODEX_USAGE_TIMEOUT Seconds to wait for account usage. Default: 30

Examples:
  kodex alice
  kodex alice usage
  kodex alice usage --json
  kodex bob exec "summarize this repo"
  KODEX_PROFILES_DIR=/Users/Shared/codex-profiles kodex alice
USAGE
}

die() {
  printf 'kodex: %s\n' "$*" >&2
  exit 1
}

confirm() {
  local prompt=$1
  local answer

  if [[ ! -t 0 ]]; then
    return 1
  fi

  read -r -p "$prompt [y/N] " answer
  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

codex_usage_profile() {
  local output_json=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        output_json=1
        shift
        ;;
      -h|--help)
        cat >&2 <<'USAGE'
Usage: kodex <profile> usage [--json]

Reads ChatGPT Codex rate-limit usage for the selected profile.

Options:
  --json  Print the raw JSON payload.
USAGE
        return 2
        ;;
      *)
        die "unknown usage option '$1'"
        ;;
    esac
  done

  if ! command -v python3 >/dev/null 2>&1; then
    die "python3 is required for 'kodex <profile> usage'"
  fi

  KODEX_USAGE_JSON="$output_json" \
  KODEX_USAGE_PROFILE="$profile" \
  KODEX_USAGE_CODEX_BIN="$codex_bin" \
  python3 <<'PY'
import datetime as _datetime
import json
import os
import queue
import subprocess
import sys
import threading
import time


def fail(message, code=1):
    print(f"kodex: {message}", file=sys.stderr)
    sys.exit(code)


def send(proc, message):
    assert proc.stdin is not None
    proc.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
    proc.stdin.flush()


def start_reader(stream):
    lines = queue.Queue()

    def read_loop():
        try:
            for line in stream:
                lines.put(line)
        finally:
            lines.put(None)

    threading.Thread(target=read_loop, daemon=True).start()
    return lines


def read_responses(lines, wanted_ids, timeout):
    deadline = time.monotonic() + timeout
    responses = {}

    while wanted_ids - responses.keys():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break

        try:
            line = lines.get(timeout=remaining)
        except queue.Empty:
            break

        if line is None:
            break

        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue

        message_id = message.get("id")
        if message_id in wanted_ids:
            responses[message_id] = message

    return responses


def shutdown(proc):
    try:
        if proc.stdin:
            proc.stdin.close()
    except BrokenPipeError:
        pass

    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=2)


def percent(value):
    if value is None:
        return "unknown"
    if isinstance(value, int) or (isinstance(value, float) and value.is_integer()):
        return f"{int(value)}%"
    return f"{value:.1f}%"


def format_time(epoch_seconds):
    if epoch_seconds is None:
        return "unknown"
    try:
        dt = _datetime.datetime.fromtimestamp(epoch_seconds).astimezone()
    except (OSError, OverflowError, TypeError, ValueError):
        return str(epoch_seconds)
    return dt.strftime("%Y-%m-%d %H:%M:%S %Z")


def describe_window(label, window):
    if not window:
        return f"  {label}: unavailable"

    used = percent(window.get("usedPercent"))
    duration = window.get("windowDurationMins")
    resets = format_time(window.get("resetsAt"))
    duration_text = f", window {duration} min" if duration is not None else ""
    return f"  {label}: {used} used{duration_text}, resets {resets}"


def describe_credits(credits):
    if not credits:
        return None
    if credits.get("unlimited"):
        return "  Credits: unlimited"
    if credits.get("hasCredits") is False:
        return "  Credits: none"
    balance = credits.get("balance")
    if balance:
        return f"  Credits: available, balance {balance}"
    if credits.get("hasCredits"):
        return "  Credits: available"
    return "  Credits: unknown"


def account_label(account):
    if not account:
        return "not logged in"
    account_type = account.get("type", "unknown")
    if account_type == "chatgpt":
        email = account.get("email") or "unknown email"
        plan = account.get("planType")
        return f"{email} ({plan})" if plan else email
    if account_type == "apiKey":
        return "API key"
    return account_type


def print_human(profile, account_response, rate_response):
    account = None
    if account_response and "result" in account_response:
        account = account_response["result"].get("account")

    print(f"Profile: {profile}")
    print(f"Account: {account_label(account)}")

    rate_limits = rate_response["result"]["rateLimits"]
    by_id = rate_response["result"].get("rateLimitsByLimitId") or {}
    snapshots = list(by_id.values()) if by_id else [rate_limits]

    for index, snapshot in enumerate(snapshots):
        if not snapshot:
            continue
        name = snapshot.get("limitName") or snapshot.get("limitId") or "codex"
        if len(snapshots) == 1:
            print(f"Usage: {name}")
        else:
            if index:
                print()
            print(f"Usage: {name}")

        plan = snapshot.get("planType")
        if plan:
            print(f"  Plan: {plan}")
        print(describe_window("Primary", snapshot.get("primary")))
        if snapshot.get("secondary"):
            print(describe_window("Secondary", snapshot.get("secondary")))

        credits = describe_credits(snapshot.get("credits"))
        if credits:
            print(credits)

        reached = snapshot.get("rateLimitReachedType")
        if reached:
            print(f"  Limit reached: {reached}")


profile = os.environ.get("KODEX_USAGE_PROFILE", "unknown")
codex_bin = os.environ.get("KODEX_USAGE_CODEX_BIN", "codex")
output_json = os.environ.get("KODEX_USAGE_JSON") == "1"

try:
    timeout = float(os.environ.get("KODEX_USAGE_TIMEOUT", "30"))
except ValueError:
    fail("KODEX_USAGE_TIMEOUT must be a number")

env = os.environ.copy()
proc = None

try:
    proc = subprocess.Popen(
        [codex_bin, "app-server", "--listen", "stdio://"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )
    lines = start_reader(proc.stdout)

    send(proc, {
        "id": 1,
        "method": "initialize",
        "params": {
            "clientInfo": {
                "name": "kodex",
                "title": "kodex",
                "version": "0.1.0",
            },
            "capabilities": {
                "optOutNotificationMethods": [
                    "remoteControl/status/changed",
                    "account/rateLimits/updated",
                ],
            },
        },
    })
    send(proc, {"method": "initialized", "params": {}})
    send(proc, {
        "id": 2,
        "method": "account/read",
        "params": {"refreshToken": False},
    })
    send(proc, {"id": 3, "method": "account/rateLimits/read"})

    responses = read_responses(lines, {1, 2, 3}, timeout)
finally:
    if proc is not None:
        shutdown(proc)

if 1 not in responses:
    fail("timed out waiting for app-server initialization")

if "error" in responses[1]:
    fail(f"app-server initialization failed: {responses[1]['error'].get('message', responses[1]['error'])}")

if 3 not in responses:
    fail("timed out waiting for account usage")

rate_response = responses[3]
if "error" in rate_response:
    message = rate_response["error"].get("message", rate_response["error"])
    print(f"kodex: usage unavailable for profile '{profile}': {message}", file=sys.stderr)
    if "authentication required" in str(message) or "chatgpt authentication required" in str(message):
        print(f"kodex: run 'kodex {profile} login' and choose ChatGPT auth", file=sys.stderr)
    sys.exit(1)

account_response = responses.get(2)

if output_json:
    print(json.dumps({
        "profile": profile,
        "account": account_response.get("result") if account_response and "result" in account_response else None,
        "usage": rate_response["result"],
    }, indent=2, sort_keys=True))
else:
    print_human(profile, account_response, rate_response)
PY
}

if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 2
fi

profile=$1
shift

if [[ ! "$profile" =~ ^[A-Za-z0-9._-]+$ ]]; then
  die "invalid profile '$profile'; use only letters, numbers, dot, underscore, or hyphen"
fi

profiles_dir=${KODEX_PROFILES_DIR:-"$HOME/.kodex/profiles"}
codex_bin=${KODEX_CODEX_BIN:-codex}
profile_home="$profiles_dir/$profile"

if [[ ! -d "$profile_home" ]]; then
  printf "kodex: profile '%s' does not exist at %s\n" "$profile" "$profile_home" >&2
  if confirm "Create it now?"; then
    mkdir -p "$profile_home"
    chmod 700 "$profile_home"
    printf "kodex: created profile '%s'\n" "$profile" >&2
  else
    die "profile not created"
  fi
fi

if ! command -v "$codex_bin" >/dev/null 2>&1; then
  die "could not find codex binary '$codex_bin'; set KODEX_CODEX_BIN=/path/to/codex"
fi

export CODEX_HOME="$profile_home"

if [[ "${1:-}" == "usage" ]]; then
  shift
  codex_usage_profile "$@"
  exit $?
fi

exec "$codex_bin" "$@"
